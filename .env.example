# Set a long random value before exposing the API. All API routes require this token.
ADMIN_API_TOKEN=replace-with-a-long-random-secret
# Matches StateDirectory=iot-modbus-service in deploy/iot-modbus.service.
DATABASE_PATH=/var/lib/iot-modbus-service/iot-modbus.db
TCP_LISTEN_HOST=0.0.0.0
TCP_LISTEN_PORT=5001
DEFAULT_STALE_AFTER_SECONDS=30
MODBUS_MIN_REQUEST_INTERVAL_MS=50
EVENT_RETENTION_DAYS=90
MEASUREMENT_RETENTION_DAYS=365
# Seed persistent ME31 AO timeout settings for range reads, FC16 acknowledgements,
# and FC03 setpoint readback. Admins can also update these in Settings.
OUTPUT_RANGE_TIMEOUT_MS=5000
OUTPUT_WRITE_TIMEOUT_MS=5000
OUTPUT_READBACK_TIMEOUT_MS=5000
# Bounded pipeline workers; Modbus transactions remain serialized per gateway.
PIPELINE_MAX_CONCURRENCY=8
PIPELINE_SHUTDOWN_GRACE_MS=10000
TCP_MAX_CONNECTIONS=128
TCP_MAX_PENDING_SESSIONS=32
# Disabled by default. Gateway liveness comes from read-only Modbus checks,
# not receive-side inactivity (stable outputs may produce no unsolicited data).
TCP_IDLE_TIMEOUT_SECONDS=0
TCP_KEEPALIVE_IDLE_SECONDS=60
TCP_KEEPALIVE_INTERVAL_SECONDS=15
TCP_KEEPALIVE_COUNT=4
# Optional TLS for the gateway listener. If enabled, both files are required.
# TLS identity commissioning requires a trusted client VPN/network or mutual TLS deployment.
# TCP_TLS_CERT_FILE=/etc/iot-modbus-service/gateway-listener.crt
# TCP_TLS_KEY_FILE=/etc/iot-modbus-service/gateway-listener.key
# GATEWAY_TRUSTED_CIDRS=10.70.0.0/16
# Secure automatic commissioning for G781 MODBUS_TCP and W630 transparent RTU:
# terminate an authenticated WireGuard site tunnel on this VPS and bind each
# gateway's dedicated listener to its private wg0 address. Never expose these
# ports on a public interface. Each gateway stores its unique VPN peer /32.
GATEWAY_TRUSTED_INGRESS_ENABLED=false
# Keep disabled unless the exact G781 firmware and transparent RTU mode have
# been bench-validated to send the LINK registration packet without modifying
# the Modbus stream. This is not supported for the verified G781 MODBUS_TCP or W630.
GATEWAY_LINK_IDENTITY_ENABLED=false
# GATEWAY_TRUSTED_INGRESS_HOST=10.70.0.1
# GATEWAY_TRUSTED_INGRESS_INTERFACE=wg0
GATEWAY_HEALTHCHECK_ENABLED=true
GATEWAY_HEALTHCHECK_INTERVAL_SECONDS=30
GATEWAY_HEALTHCHECK_TIMEOUT_MS=5000
GATEWAY_HEALTHCHECK_FAILURE_THRESHOLD=3
