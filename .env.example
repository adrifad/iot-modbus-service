# Set a long random value before exposing the API. All API routes require this token.
ADMIN_API_TOKEN=replace-with-a-long-random-secret
DATABASE_PATH=./data/iot-modbus.db
TCP_LISTEN_HOST=0.0.0.0
TCP_LISTEN_PORT=5001
HTTP_LISTEN_HOST=127.0.0.1
HTTP_LISTEN_PORT=8000
DEFAULT_STALE_AFTER_SECONDS=30
MODBUS_MIN_REQUEST_INTERVAL_MS=50
EVENT_RETENTION_DAYS=90
MEASUREMENT_RETENTION_DAYS=365
TCP_MAX_CONNECTIONS=128
TCP_MAX_PENDING_SESSIONS=32
